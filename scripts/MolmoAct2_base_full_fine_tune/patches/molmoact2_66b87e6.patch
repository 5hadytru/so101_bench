+def build_molmoact2_so101_bench_sim_wm() -> Tuple[List[RawMixtureEntry], Dict[str, Dict[str, object]]]:
+    return build_single_lerobot_mixture(
+        name="so101_bench_sim_wm",
+        tag="so101_bench_sim_wm",
+        repo_ids=["5hadytru/so101_bench_sim_WM_molmoframe"],
+        action_key="action",
+        state_keys=["observation.state"],
+        camera_keys=[
