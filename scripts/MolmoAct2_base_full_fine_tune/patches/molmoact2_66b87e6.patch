+            "observation.images.wrist_init",
+        ],
+        normalize_gripper=True,
+        setup_type="single so100/so101 robotic arm in molmoact2",
+        control_mode="absolute joint pose",
+        action_horizon=30,
+        n_action_steps=30,
+    )
+
+
+MOLMOACT2_LEROBOT_MIXTURES["so101_bench_sim_wm"] = build_molmoact2_so101_bench_sim_wm
