+class ResumeStepIntervalsCallback(TrainerCallback):
+    """Apply this launch's logging/save/eval intervals when resuming.
+
+    transformers loads trainer_state.json from the resume checkpoint after it computes the
+    step intervals from TrainingArguments, so a resumed run silently keeps the checkpoint's
+    save_steps (e.g. 2000) instead of the requested one (e.g. 500). on_train_begin runs after
+    that load, so re-apply the intervals here.
+    """
+
+    def on_train_begin(self, args, state, control, **kwargs):
+        state.compute_steps(args, state.max_steps)
+
